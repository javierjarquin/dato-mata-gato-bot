# Copiar a .env y completar. Nunca commitear .env con el token real.

TELEGRAM_BOT_TOKEN=

# IDs de chat de Telegram autorizados a usar el bot, separados por coma.
# Vacío = nadie puede usarlo (seguro por defecto). Tu chat_id te lo dice
# el bot la primera vez que le escribas sin estar en la lista.
TELEGRAM_ALLOWED_CHAT_IDS=

LOG_LEVEL=INFO
