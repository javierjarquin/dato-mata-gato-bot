# Copiar a .env y completar. Nunca commitear .env con el token real.

TELEGRAM_BOT_TOKEN=

# IDs de chat de Telegram autorizados a usar el bot, separados por coma.
# Vacío = nadie puede usarlo (seguro por defecto). Tu chat_id te lo dice
# el bot la primera vez que le escribas sin estar en la lista.
TELEGRAM_ALLOWED_CHAT_IDS=

LOG_LEVEL=INFO

# ID de la carpeta de Google Drive donde se sube cada video final (el
# string de la URL después de /folders/). Requiere haber corrido antes
# `python -m dato_mata_gato_bot.drive_auth` una vez -- ver README.md.
GOOGLE_DRIVE_FOLDER_ID=
